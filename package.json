{
  "name": "agvsr",
  "version": "1.0.0",
  "private": false,
   "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agvsr": "src/cli/agvsr.ts"
  },
  "files": [
    "src",
    "charters",
    "commands",
    "examples",
    "skills",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "agvsr": "bun run src/cli/agvsr.ts",
    "daemon": "bun run agvsr daemon",
    "job": "bun run agvsr job",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bunx oxfmt src && bun run typecheck && bun test && bunx oxlint src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
